{
  "name": "area-backend",
  "version": "1.0.0",
  "description": "AREA Backend - Action-Reaction automation platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "dev:old": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest __tests__/unit --verbose",
    "test:all": "jest"
  },
  "author": "Team Bastian, Dylan, Adam, Eric, Elias",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "bull": "^4.16.5",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "discord.js": "^14.22.1",
    "dotenv": "^16.0.0",
    "eventsource": "^4.0.0",
    "express": "^5.1.0",
    "googleapis": "^162.0.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "redis": "^5.8.2",
    "rss-parser": "^3.13.0",
    "tslib": "^2.8.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.0",
    "@types/colors": "^1.1.3",
    "@types/cors": "^2.8.0",
    "@types/eventsource": "^1.1.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.18.8",
    "@types/pg": "^8.6.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "nodemon": "^3.0.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
